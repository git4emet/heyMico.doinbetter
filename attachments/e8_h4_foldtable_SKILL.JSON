        self.detection_module = self.module_system.load_module('detection')\
        self.resolution_module = self.module_system.load_module('resolution')\
\
    def extract_archive(self, archive_path, extract_to):\
        """Extract a zip or tar archive to a directory."""\
        if zipfile.is_zipfile(archive_path):\
            with zipfile.ZipFile(archive_path, 'r') as zip_ref:\
                zip_ref.extractall(extract_to)\
        elif tarfile.is_tarfile(archive_path):\
            with tarfile.open(archive_path, 'r:*') as tar_ref:\
                tar_ref.extractall(extract_to)\
        else:\
            # Assume it's already a directory\
            shutil.copytree(archive_path, extract_to, dirs_exist_ok=True)\
        return extract_to\
\
    def run_cycle(self):\
        """Run a single scan-and-resolve cycle."""\
        self.cycle_count += 1\
        print(f"\n{'='*60}")\
        print(f"🌀 QBRE CYCLE {self.cycle_count} - {datetime.now().isoformat()}")\
        print(f"{'='*60}")\
\
        # 1. Locate and extract the latest archive\
        if self.archive_path.is_file():\
            extract_dir = self.processing_base / f"extracted_{self.cycle_count}"\
            print(f"[1/3] Extracting archive: {self.archive_path.name}")\
            self.extract_archive(self.archive_path, extract_dir)\
        else:\
            # If it's a directory, use it directly\
            extract_dir = self.archive_path\
\
        # 2. Detect Buddies using the (potentially hot-swapped) detection module\
        print(f"[2/3] Scanning for Buddies in: {extract_dir}")\
        # Use the module's scan function if it exists, otherwise use default detector\
        if hasattr(self.detection_module, 'scan_directory'):\
            buddies = self.detection_module.scan_directory(extract_dir)\
        else:\
            buddies = self.detector.scan_directory(extract_dir)\
\
        # 3. Resolve each Buddy using the (potentially hot-swapped) resolution module\
        print(f"[3/3] Resolving {len(buddies)} Buddy instances...")\
        new_buddies = 0\
        for buddy in buddies:\
            # Use module's resolve function if it exists\
            if hasattr(self.resolution_module, 'resolve'):\
                resolved_data = self.resolution_module.resolve(buddy)\
            else:\
                resolved_data = buddy  # Pass-through\
            if self.resolver.resolve_and_store(resolved_data):\
                new_buddies += 1\
\
        # 4. Cleanup and report\
        if self.archive_path.is_file():\
            shutil.rmtree(extract_dir, ignore_errors=True)\
        print(f"[CYCLE COMPLETE] New Buddies integrated: {new_buddies}")\
        return new_buddies\
\
    def run_continuous(self, interval_seconds=30, max_cycles=None):\
        """Run the resolution loop continuously until stopped."""\
        self.running = True\
        print("\n🚀 Quantum Buddy Resolution Engine Started")\
        print(f"   Watching: {self.archive_path}")\
        print(f"   DB: {STATE_DB}")\
        print(f"   Modules: {MODULES_DIR}")\
        print("   Press Ctrl+C to stop\n")\
        try:\
            cycle_num = 0\
            while self.running:\
                if max_cycles and cycle_num >= max_cycles:\
                    break\
                self.run_cycle()\
                cycle_num += 1\
                time.sleep(interval_seconds)\
        except KeyboardInterrupt:\
            print("\n\n🛑 QBRE stopped by user.")\
        finally:\
            self.running = False\
            if hasattr(self.module_system, 'observer'):\
                self.module_system.observer.stop()\
                self.module_system.observer.join()\
