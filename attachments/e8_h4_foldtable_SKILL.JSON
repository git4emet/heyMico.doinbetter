// ui/components/MemoryRecall.jsx
import React, { useState } from "react";
function MemoryRecall() {
  const [query, setQuery] = useState("");
  const [results, setResults] = useState([]);
  const [loading, setLoading] = useState(false);
  async function handleSearch() {
    if (!query.trim()) return;
    setLoading(true);
    try {
      const res = await fetch(/dosx3/memory/search?query=${encodeURIComponent(query)}&top_k=5);
      const data = await res.json();
      setResults(data.results || []);
    } catch (err) {
      console.error("Memory search failed:", err);
    }
    setLoading(false);
  }
  return (
    <div className="p-4 bg-[#0b1630] text-[#e6f0ff] rounded-xl shadow-lg">
      <h2 className="text-xl font-bold mb-2">🧠 Memory Recall</h2>
      <div className="flex mb-4">
        <input
          type="text"
          value={query}
          placeholder="Search memory (e.g. guardian rollback, TinyBox bootloader)"
          onChange={(e) => setQuery(e.target.value)}
          className="flex-1 px-3 py-2 bg-[#121923] border border-[#223047] rounded text-sm"
        />
        <button
          onClick={handleSearch}
          disabled={loading}
          className="ml-2 px-4 py-2 bg-[#5fe1b3] text-black font-semibold rounded hover:bg-[#4bc99e]"
        >
          {loading ? "Searching..." : "Search"}
        </button>
      </div>
      {results.length > 0 ? (
        <div className="space-y-3">
          {results.map((r, i) => (
            <div key={i} className="p-3 border border-[#223047] rounded bg-[#121923]">
              <div className="text-sm text-[#99aac2]">Score: {r.score}</div>
              <div className="font-semibold">{r.file}</div>
              <div className="text-xs text-[#99aac2]">Tags: {r.tags.join(", ")}</div>
              <pre className="text-xs mt-2 whitespace-pre-wrap">
                {r.snippet}
              </pre>
            </div>
          ))}
        </div>
      ) : (
        <p className="text-sm text-[#99aac2]">
          {loading ? "Searching..." : "No results yet"}
        </p>
      )}
    </div>
  );
}
export default MemoryRecall;
