            if "light on" in input_text:
                self.ha_call_service("light", "turn_on", {"entity_id": "light.living_room"})
                return "Lights on"
            state = self.ha_get_state("sensor.temperature")
            return f"Home temp: {state}°C"
        return super().process(input_text)  # Existing FQ0

