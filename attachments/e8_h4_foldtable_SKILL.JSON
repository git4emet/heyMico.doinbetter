# Nash-Sutcliffe
def nash_sutcliffe(obs, pred):
    return 1 - np.sum((obs - pred)**2) / np.sum((obs - np.mean(obs))**2)
# Benchmark function
def run_benchmark():
    results = {'direct_lstm': [], 'e8_hybrid': []}
    times = {'direct_lstm': [], 'e8_hybrid': []}
   
    obs = np.array([tc['actual'] for tc in test_cases])
   
    for tc in test_cases:
        sensors = tc['sensors']
       
        # Direct LSTM path
        start = time.time()
        direct_pred = stub_lstm(sensors)
        times['direct_lstm'].append(time.time() - start)
        results['direct_lstm'].append(direct_pred)
       
        # E8 Hybrid path
        start = time.time()
        stabilized = e8_decode(sensors)
        fused = octonion_multiply_numba(stabilized, stabilized) # Sim fusion
        hybrid_pred = stub_lstm(fused)
        times['e8_hybrid'].append(time.time() - start)
        results['e8_hybrid'].append(hybrid_pred)
   
    for key in results:
        nse = nash_sutcliffe(obs, np.array(results[key]))
        avg_time = np.mean(times[key]) * 1000
        print(f"{key.upper()}: NSE={nse:.3f}, Avg Latency={avg_time:.1f}ms")
run_benchmark()
