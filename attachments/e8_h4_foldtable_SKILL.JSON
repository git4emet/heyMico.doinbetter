import imaplib, email, os, json, datetime
IMAP_SERVER = "imap.gmail.com"
IMAP_PORT = 993
EMAIL_ACCOUNT = os.getenv("BUDDY_EMAIL")
EMAIL_PASSWORD = os.getenv("BUDDY_PASS")
def sweep_mailbox():
    conn = imaplib.IMAP4_SSL(IMAP_SERVER, IMAP_PORT)
    conn.login(EMAIL_ACCOUNT, EMAIL_PASSWORD)
    conn.select("inbox")
    typ, data = conn.search(None, "ALL")
    msgs = data[0].split()
    manifest = {"buddy_mail_manifest": {"last_sweep": datetime.datetime.utcnow().isoformat(), "threads": []}}
    taily = []
    for num in msgs[-200:]: # limit sweep to last 200 for first run
        typ, data = conn.fetch(num, "(RFC822)")
        msg = email.message_from_bytes(data[0][1])
        subject = msg["subject"]
        date = msg["date"]
        snippet = msg.get_payload(decode=True)[:120].decode(errors="ignore")
