📜 Upgraded Sweeper with Auto-Scoring
import imaplib, email, os, json, datetime, re
from email.header import decode_header
IMAP_SERVER = "imap.gmail.com"
IMAP_PORT = 993
EMAIL_ACCOUNT = os.getenv("BUDDY_EMAIL")
EMAIL_PASSWORD = os.getenv("BUDDY_PASS")
ATTACH_DIR = "archives/mail_attachments"
os.makedirs(ATTACH_DIR, exist_ok=True)
AGI_STATUS_FILE = "reports/agi_status.json"
Mapping of tags → AGI metrics
TAG_METRIC_MAP = {
"mobiius": "1_unified_world_model",
"seed": "1_unified_world_model",
"tinybox": "5_grounded_action_loop",
"guardian": "6_integrated_ethics_alignment",
"ethics": "6_integrated_ethics_alignment",
"fart": "3_robust_general_memory",
"fast": "3_robust_general_memory",
"viewport": "7_transfer_teaching_human_loop",
"miko": "7_transfer_teaching_human_loop",
"compliance": "6_integrated_ethics_alignment"
}
def clean_subject(subject):
if not subject:
return "No Subject"
subject, encoding = decode_header(subject)[0]
if isinstance(subject, bytes):
subject = subject.decode(encoding or "utf-8", errors="ignore")
return subject
def save_attachment(part, email_uid):
filename = part.get_filename()
if filename:
filename, encoding = decode_header(filename)[0]
if isinstance(filename, bytes):
filename = filename.decode(encoding or "utf-8", errors="ignore")
safe_name = f"{email_uid}_{filename}"
filepath = os.path.join(ATTACH_DIR, safe_name)
with open(filepath, "wb") as f:
f.write(part.get_payload(decode=True))
return filepath
return None
def load_agi_status():
if os.path.exists(AGI_STATUS_FILE):
with open(AGI_STATUS_FILE, "r") as f:
return json.load(f)
# Default structure if missing
return {
"mobiius_agi_status": {
"last_update": datetime.datetime.utcnow().isoformat(),
"stack_version": "unknown",
"metrics": {
"1_unified_world_model": {"score": 0.0, "notes": ""},
"2_recursive_self_improvement": {"score": 0.0, "notes": ""},
"3_robust_general_memory": {"score": 0.0, "notes": ""},
"4_open_ended_autonomy": {"score": 0.0, "notes": ""},
"5_grounded_action_loop": {"score": 0.0, "notes": ""},
"6_integrated_ethics_alignment": {"score": 0.0, "notes": ""},
"7_transfer_teaching_human_loop": {"score": 0.0, "notes": ""},
"8_resilience_recovery": {"score": 0.0, "notes": ""}
}
}
}
def bump_metric(agi_status, metric, note):
m = agi_status["mobiius_agi_status"]["metrics"][metric]
old_score = m["score"]
new_score = min(1.0, round(old_score + 0.05, 2))
m["score"] = new_score
m["notes"] = f"{m['notes']} | Bumped on {datetime.datetime.utcnow().isoformat()} due to {note}"
return new_score
def sweep_mailbox():
conn = imaplib.IMAP4_SSL(IMAP_SERVER, IMAP_PORT)
conn.login(EMAIL_ACCOUNT, EMAIL_PASSWORD)
conn.select("inbox")
typ, data = conn.search(None, "ALL")
msgs = data[0].split()
manifest = {"buddy_mail_manifest": {"last_sweep": datetime.datetime.utcnow().isoformat(), "threads": []}}
taily = []
agi_status = load_agi_status()
for num in msgs[-200:]: # scan last 200 emails
    typ, data = conn.fetch(num, "(RFC822)")
    msg = email.message_from_bytes(data[0][1])
    subject = clean_subject(msg["subject"])
    date = msg["date"]
    snippet = ""
    attachments = []
    # Extract snippet
    for part in msg.walk():
        if part.get_content_type() == "text/plain":
            snippet = part.get_payload(decode=True)[:200].decode(errors="ignore")
            break
    # Save attachments
    for part in msg.walk():
        if part.get_content_disposition() == "attachment":
            filepath = save_attachment(part, num.decode())
            if filepath:
                attachments.append(filepath)
    # Tagging
    tags = []
    for kw in TAG_METRIC_MAP.keys():
        if subject and re.search(kw, subject, re.IGNORECASE):
            tags.append(kw)
    # Update AGI metrics if tags found
    for tag in tags:
        metric = TAG_METRIC_MAP[tag]
        bump_metric(agi_status, metric, f"Email '{subject}' tagged {tag}")
    entry = {
        "id": str(num.decode()),
        "subject": subject,
        "date": date,
        "tags": tags,
        "snippet": snippet,
        "attachments": attachments
    }
    manifest["buddy_mail_manifest"]["threads"].append(entry)
    taily.append({
        "ts": datetime.datetime.utcnow().isoformat(),
        "source": "gmail",
        "thread_id": str(num.decode()),
        "action": "ingested",
        "affects_metrics": tags,
        "notes": f"Ingested mail: {subject}",
        "attachments": attachments
    })
# Save outputs
with open("buddy_mail_manifest.json", "w") as f:
    json.dump(manifest, f, indent=2)
os.makedirs("reports", exist_ok=True)
with open("reports/taily.jsonl", "a") as f:
    for row in taily:
        f.write(json.dumps(row) + "\n")
# Save updated AGI status
agi_status["mobiius_agi_status"]["last_update"] = datetime.datetime.utcnow().isoformat()
with open(AGI_STATUS_FILE, "w") as f:
    json.dump(agi_status, f, indent=2)
conn.close()
conn.logout()
if name == "main":
sweep_mailbox()
print("Sweep complete → manifest + Taily updated + AGI metrics bumped")
