import React, { useState, useEffect } from 'react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend } from 'recharts';
import io from 'socket.io-client';
const FloodChart = () => {
  const [data, setData] = useState([
    { name: 'Day 1', floodLevel: 400 },
    { name: 'Day 2', floodLevel: 300 },
    { name: 'Day 3', floodLevel: 300 },
    { name: 'Day 4', floodLevel: 200 },
    { name: 'Day 5', floodLevel: 278 },
    { name: 'Day 6', floodLevel: 189 },
  ]);
  useEffect(() => {
    const socket = io('http://localhost:5000');
    socket.on('flood_update', (newData) => {
      setData((prev) => [...prev, { name: `Day ${prev.length + 1}`, floodLevel: newData.prediction }]);
    });
    return () => socket.disconnect();
  }, []);
  return (
    <LineChart width={600} height={300} data={data}>
      <CartesianGrid strokeDasharray="3 3" />
      <XAxis dataKey="name" />
      <YAxis />
      <Tooltip />
      <Legend />
      <Line type="monotone" dataKey="floodLevel" stroke="#4B0082" />
    </LineChart>
  );
};
export default FloodChart;
