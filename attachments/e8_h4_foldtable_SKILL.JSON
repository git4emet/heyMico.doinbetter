        self.ha_token = ha_token
        self.ha_headers = {
            "Authorization": f"Bearer {ha_token}",
            "Content-Type": "application/json"
        }

    async def ha_websocket_listen(self):
        uri = self.ha_url.replace('http', 'ws') + '/api/websocket'
        async with websockets.connect(uri) as ws:
            await ws.send(json.dumps({"id": 1, "type": "auth", "access_token": self.ha_token}))
            await ws.recv()  # Auth OK
            await ws.send(json.dumps({"id": 2, "type": "subscribe_events", "event_type": "state_changed"}))
            while True:
                msg = json.loads(await ws.recv())
                if msg['type'] == 'event':
                    # Resonant event: e.g., light changed → shuffle to vocab
                    entity = msg['event']['data']['entity_id']
                    state = msg['event']['data']['new_state']['state']
                    self.speak(f"Home update: {entity} is {state}")

    def ha_get_state(self, entity_id):
        url = f"{self.ha_url}/api/states/{entity_id}"
        response = requests.get(url, headers=self.ha_headers)
        if response.status_code == 200:
            return response.json()['state']
        return None

    def ha_call_service(self, domain, service, data):
        # Ethical gate: When consent, then call
        if not self.consent_check():  # Placeholder for voice/gate
            return "Consent required"
        url = f"{self.ha_url}/api/services/{domain}/{service}"
        response = requests.post(url, headers=self.ha_headers, json=data)
        return response.json() if response.status_code == 200 else None

    def consent_check(self):
        # From ethical gates: When user says "ok", then True
        return True  # Stub; integrate voice keyword

    def process(self, input_text):
