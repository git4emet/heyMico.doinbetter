def fetch_usgs_gauge(site='07289000', days=7):
    end = datetime.now().strftime('%Y-%m-%d')
    start = (datetime.now() - timedelta(days=days)).strftime('%Y-%m-%d')
    url = f"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={site}&parameterCd=00065,00060&startDT={start}&endDT={end}"
    resp = requests.get(url).json()
    # Parse: resp['value']['timeSeries'][0]['values'][0]['value'][-1]['value'] for latest
    return resp
