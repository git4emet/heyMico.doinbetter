class FractalDB:
    def __init__(self):
        self.conn = sqlite3.connect('mobius.db')
        self.cursor = self.conn.cursor()
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS toroid 
            (domain INT, layer INT, plane INT, value TEXT)''')

    def insert(self, domain, layer, plane, value):
        self.cursor.execute("INSERT INTO toroid VALUES (?, ?, ?, ?)", 
                            (domain, layer, plane, value))
        self.conn.commit()

    def query(self, domain):
        self.cursor.execute("SELECT * FROM toroid WHERE domain=?", (domain,))
        return self.cursor.fetchall()

