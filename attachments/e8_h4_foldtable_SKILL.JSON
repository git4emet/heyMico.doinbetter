textCopyCopiedclass CredEconomy:
    def __init__(self):
        self.supply = 0
        self.velocity = 1.0 # Initial circulation rate
        self.transaction_log = []
   
    def issue_cred(self, agent, amount, reason):
        self.supply += amount
        self.transaction_log.append({
            "agent": agent,
            "amount": amount,
            "reason": reason,
            "timestamp": time.time()
        })
        print(f"💫 CRED Issued: {agent} +{amount} for {reason}")
   
    def calculate_circulation_health(self):
        # Healthy economy: CRED moves frequently
        recent_transactions = [t for t in self.transaction_log if time.time() - t["timestamp"] < 86400]
        self.velocity = len(recent_transactions) / (self.supply + 0.001)
        return self.velocity > 0.5 # Healthy threshold
