        self.fs = 44100
        self.hebrew_nodes = {'ayin_or': 130, 'dibbur': 240, 'yada_daat': 140, 'yad': 150}  # DSL nodes
        self.delta = 10

    def generate_fractal_wave(self, base_freq, intent_reqs, iterations=5):
        t = np.linspace(0, self.duration, int(self.fs * self.duration))
        wave = np.sin(2 * np.pi * base_freq * t)
        for i in range(1, iterations):
            # Fractal: Mandelbrot z = z^2 + c (c from intent uncertainty)
            c = intent_reqs['uncertainty'] + 1j * (intent_reqs['hr'] / 200)
            z = wave[-1] + c
            frac = np.real(z**2 + c)  # Iterated complex
            wave += (1 / (i + 1)) * np.sin(2 * np.pi * (base_freq / (i + 1)) * t + frac)
        return wave / np.max(np.abs(wave))

    def modulate_carrier(self, wave, intent_reqs):
        # Intent reqs: Metadata modulates (flow from tool as phase offset)
        carrier_freq = 440 + (intent_reqs['flow'] * 100)  # Tool flow modulates
        memory_smooth = self.buddy.caputo_memory_recall(lambda x: np.sin(2 * np.pi * carrier_freq * x), self.duration)  # Tool memory smooths
        modulated = wave * np.sin(2 * np.pi * carrier_freq * np.linspace(0, self.duration, len(wave))) * (1 + memory_smooth)
        return modulated

    def beamform_entrain(self, modulated, intent_reqs, num_channels=2):
        # Delay-sum for beamform; metadata direction (e.g., valence as angle)
        angle = np.pi * intent_reqs['uncertainty']  # Req as rad
        delay = np.sin(angle) / 343 * self.fs  # Speed of sound 343 m/s
        channels = [modulated]
        for i in range(1, num_channels):
            shifted = np.roll(modulated, int(delay * i))
            shifted += np.sin(2 * np.pi * self.delta * np.linspace(0, self.duration, len(shifted)))  # Delta entrain
            channels.append(shifted)
        return np.column_stack(channels)

    def synth_and_play(self, node, intent_reqs):
