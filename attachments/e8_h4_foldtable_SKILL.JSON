        entry = {
            "id": str(num.decode()),
            "subject": subject,
            "date": date,
            "tags": tags,
            "snippet": snippet
        }
        manifest["buddy_mail_manifest"]["threads"].append(entry)
        taily.append({
            "ts": datetime.datetime.utcnow().isoformat(),
            "source": "gmail",
            "thread_id": str(num.decode()),
            "action": "ingested",
            "affects_metrics": tags,
