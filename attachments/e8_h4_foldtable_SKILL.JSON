textCopyCopied# fractional_calculus.py
import numpy as np
from scipy.special import gamma
def caputo_derivative(f, alpha=0.6, t_start=0, t_end=30):
    """JTP v13.5 certified Caputo fractional derivative"""
    def kernel(t, tau):
        return (t - tau) ** (-alpha)
  
    integral = np.zeros_like(f)
    for i, t in enumerate(np.linspace(t_start, t_end, len(f))):
        if i == 0:
            continue
        tau_vals = np.linspace(t_start, t, i+1)
        f_tau = f[:i+1]
        k_vals = kernel(t, tau_vals)
        integral[i] = np.trapz(f_tau * k_vals[:-1], tau_vals[:-1])
  
    return integral / gamma(1 - alpha)
