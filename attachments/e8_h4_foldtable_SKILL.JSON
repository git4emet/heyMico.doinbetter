class FractalEntrainment:
    def __init__(self, buddy):
        self.buddy = buddy
        self.duration = 5  # Sec for beat
        self.fs = 44100  # Sample rate
        self.hebrew_freqs = {'ayin_or': 130, 'dibbur': 240, 'yada_daat': 140, 'yad': 150}  # From PDF

    def generate_fractal_wave(self, base_freq, intent_val, iterations=5):
        # Fractal synthesis: Mandelbrot-inspired additive (self-similar harmonics)
        t = np.linspace(0, self.duration, int(self.fs * self.duration))
        wave = np.sin(2 * np.pi * base_freq * t)
        for i in range(1, iterations):
            frac = self.buddy.caputo_memory_recall(lambda x: np.sin(2 * np.pi * base_freq * x / (i + 1)), t[-1])
            wave += (1 / (i + 1)) * np.sin(2 * np.pi * (base_freq / (i + 1)) * t + frac * intent_val)  # Intent modulates phase
        return wave / np.max(np.abs(wave))  # Normalize

    def modulate_carrier(self, wave, intent_metadata):
        # Intent-mod: Valence (e.g., uncertainty) modulates amplitude/carrier freq
        carrier_freq = 440 + (intent_metadata['uncertainty'] * 100)  # e.g., high uncertainty → higher freq
        modulated = wave * np.sin(2 * np.pi * carrier_freq * np.linspace(0, self.duration, len(wave)))
        return modulated

    def beamform_entrain(self, modulated, delta=10, num_speakers=2):
        # Simple delay-sum beamform for binaural (stereo speakers); direct to user
        left = modulated
        right = np.roll(modulated, int(self.fs * 0.001))  # 1ms delay for spatial focus
        left += np.sin(2 * np.pi * delta * np.linspace(0, self.duration, len(left)))  # Entrain delta
        stereo = np.column_stack((left, right))
        return stereo

    def play_entrainment(self, node, intent_metadata):
        base = self.hebrew_freqs.get(node, 150)
        fractal = self.generate_fractal_wave(base, intent_metadata['hr'] / 200)  # HR as intent proxy
        modulated = self.modulate_carrier(fractal, intent_metadata)
        beamformed = self.beamform_entrain(modulated)
        sd.play(beamformed, self.fs)
        sd.wait()

