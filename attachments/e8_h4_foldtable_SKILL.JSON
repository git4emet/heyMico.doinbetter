# ========== MODULE HOT-SWAP SYSTEM ==========\
class HotSwapModuleSystem:\
    """Dynamically reload modules when changed, enabling self-evolution."""\
    def __init__(self, modules_dir):\
        self.modules_dir = Path(modules_dir)\
        self.modules_dir.mkdir(exist_ok=True)\
        self.loaded_modules = {}\
        self.setup_watcher()\
\
    def setup_watcher(self):\
        """Watch the modules directory for changes."""\
        class ModuleHandler(FileSystemEventHandler):\
            def on_modified(self, event):\
                if event.src_path.endswith('.py'):\
                    print(f"[HOT-SWAP] Module changed: {Path(event.src_path).name}, reloading...")\
                    self.load_module(Path(event.src_path).stem)\
        self.event_handler = ModuleHandler()\
        self.event_handler.load_module = self.load_module\
        self.observer = Observer()\
        self.observer.schedule(self.event_handler, str(self.modules_dir), recursive=False)\
        self.observer.start()\
\
    def load_module(self, module_name):\
        """Load or reload a module by name."""\
        module_path = self.modules_dir / f"{module_name}.py"\
        if not module_path.exists():\
            print(f"[HOT-SWAP] Creating default module: {module_name}.py")\
            self.create_default_module(module_name)\
        spec = importlib.util.spec_from_file_location(module_name, module_path)\
        module = importlib.util.module_from_spec(spec)\
        sys.modules[module_name] = module\
        spec.loader.exec_module(module)\
        self.loaded_modules[module_name] = module\
        print(f"[HOT-SWAP] Loaded: {module_name}")\
        return module\
\
    def create_default_module(self, module_name):\
        """Create a stub module if none exists."""\
        stub_code = f'''\
# Auto-generated stub for {module_name}\
# Replace with your evolving logic\
\
def process(data):\
    """Default processing function."""\
    return {{"status": "default", "module": "{module_name}"}}\
'''\
        (self.modules_dir / f"{module_name}.py").write_text(stub_code)\
