def e8_decode(signal):
    c1 = np.round(signal)
    if sum(c1) % 2 != 0:
        idx = np.argmax(np.abs(signal - c1))
        c1[idx] += np.sign(signal[idx] - c1[idx])
    c2 = np.round(signal - 0.5) + 0.5
    if sum(c2) % 2 != 0:
        idx = np.argmax(np.abs(signal - c2))
        c2[idx] += np.sign(signal[idx] - c2[idx])
    return c1 if np.sum((signal - c1)**2) <= np.sum((signal - c2)**2) else c2
def octonion_multiply_numba(a, b):
    # Full impl from your code...
