a) matcher module
# backend/dream/matcher.py
from dataclasses import dataclass
from typing import Dict, List, Tuple
import math, numpy as np
AXES = ["time","freq","token","topic","geo","agent","intent","rhythm"]
@dataclass
class Match:
    score: float
    axes: Dict[str, float]
    neighbors: List[str]
    suggestion: str
class DreamStreamMatcher:
    """
    v1: lightweight, fast. builds 8-axis fingerprint for an input packet,
    finds nearest exemplars, composes a triadic suggestion.
    """
    def __init__(self, store):
        # store: abstraction over your memory/ledger (recent packets, parables, exemplars)
        self.store = store
    # --- Fingerprint builders (each returns [0..1] component) ---
    def fp_time(self, ts_now: float, ts_evt: float) -> float:
        # recency boost (exp decay)
        return math.exp(-max(0.0, ts_now - ts_evt)/3600.0)
    def fp_freq(self, waveform_meta: Dict) -> float:
        # stub: normalize band-energy presence
        return float(waveform_meta.get("band_ratio", 0.5))
    def fp_token(self, text: str) -> float:
        # hash-kernel density proxy
        h = sum(ord(c) for c in text) % 997
        return (h / 997.0)
    def fp_topic(self, tags: List[str]) -> float:
        return min(1.0, len(tags)/6.0)
    def fp_geo(self, gps: Dict) -> float:
        return 1.0 if gps else 0.3
    def fp_agent(self, speakers: List[str]) -> float:
        return min(1.0, len(set(speakers))/3.0)
    def fp_intent(self, intent: str) -> float:
        table = {"ask":0.6, "report":0.7, "alert":0.9, "plan":0.8}
        return table.get(intent, 0.5)
    def fp_rhythm(self, cadence: float) -> float:
        # cadence ~ tokens/sec or syll/sec: map 1–4 to sigmoid window
        x = max(0.0, min(4.0, cadence))
        return 1/(1+math.exp(-(x-2)))
    def fingerprint(self, pkt: Dict, ts_now: float) -> np.ndarray:
        data = pkt.get("data", {})
        axes_vals = {
            "time": self.fp_time(ts_now, pkt.get("ts", ts_now)),
            "freq": self.fp_freq(data.get("audio_meta", {})),
            "token": self.fp_token(data.get("text","")),
            "topic": self.fp_topic(data.get("tags", [])),
            "geo": self.fp_geo(data.get("gps")),
            "agent": self.fp_agent(data.get("speakers", [])),
            "intent": self.fp_intent(data.get("intent","unknown")),
            "rhythm": self.fp_rhythm(data.get("cadence", 2.0)),
        }
        pkt["_axes"] = axes_vals
        return np.array([axes_vals[k] for k in AXES], dtype=float)
    def neighbors(self, fp: np.ndarray, k: int = 3) -> List[Tuple[str, float]]:
        ex = self.store.exemplars() # returns List[(id, axes_vector[8])]
        if not ex: return []
        M = np.stack([e[1] for e in ex], axis=0)
        d = np.linalg.norm(M - fp[None,:], axis=1)
        idx = np.argsort(d)[:k]
        return [(ex[i][0], float(1/(1+d[i]))) for i in idx]
    def compose(self, pkt: Dict, nbrs: List[Tuple[str, float]]) -> str:
        # triadic fusion: (closest exemplar summary) + (action) + (guard)
        if not nbrs:
            return "Propose: gather one more signal and retry fusion; route to Buddy for light clarification."
        ids = [n[0] for n in nbrs]
        summaries = [self.store.summary(i) for i in ids]
        base = summaries[0] if summaries else "closest prior unknown"
        action = "→ next: align tokens, check cadence, request missing GPS if available."
        guard = "ethics: stay within guardian envelope; redact PII."
        return f"{base} | {action} | {guard}"
    def match(self, pkt: Dict, ts_now: float) -> Match:
        fp = self.fingerprint(pkt, ts_now)
        nbrs = self.neighbors(fp, k=3)
        axes = pkt["_axes"]
        score = float(np.mean([w for _, w in nbrs])) if nbrs else 0.42
        suggestion = self.compose(pkt, nbrs)
        return Match(score=score, axes=axes, neighbors=[n[0] for n in nbrs], suggestion=suggestion)
b) simple store adapter
# backend/dream/store.py
import numpy as np
from typing import List, Tuple
class MemoryStore:
    def __init__(self):
        self._ex = [] # (id, vec[8])
        self._sum = {} # id -> summary
    def add_exemplar(self, ex_id: str, vec: np.ndarray, summary: str):
        self._ex.append((ex_id, vec.astype(float)))
        self._sum[ex_id] = summary
    def exemplars(self) -> List[Tuple[str, np.ndarray]]:
        return self._ex
    def summary(self, ex_id: str) -> str:
        return self._sum.get(ex_id, ex_id)
